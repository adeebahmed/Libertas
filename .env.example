# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# NewsAPI key (free tier) — get one at https://newsapi.org
# Required for holdings-based and category news filtering on Dashboard.
# If absent, app falls back to RSS feeds silently.
NEWS_API_KEY=

# Claude API key — get one at https://console.anthropic.com
# Required for: Insights chat, entity structure recommendations, tax strategy AI.
# If absent, all AI-powered features are hidden. Rule-based features still work.
CLAUDE_API_KEY=
